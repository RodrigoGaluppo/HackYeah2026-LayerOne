[Unit]
Description=LayerOne Central Command dashboard
After=network-online.target layerone-server.service
Wants=network-online.target

[Service]
Type=simple
User=russo
WorkingDirectory=/home/russo/layerone
ExecStart=/usr/bin/python3 /home/russo/layerone/layerone.py dashboard --config /home/russo/layerone/server.json --port 8090
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
