[Unit]
Description=LayerOne encrypted LoRa sensor node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=russo
WorkingDirectory=/home/russo/layerone
ExecStart=/usr/bin/python3 /home/russo/layerone/layerone.py node --config /home/russo/layerone/node.json
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
